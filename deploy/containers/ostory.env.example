# Copy to /opt/ostory/.env and replace every change-me value before deployment.
POSTGRES_DB=ostory
POSTGRES_USER=ostory
POSTGRES_PASSWORD=change-me-database-password

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ostory
DB_USER=ostory
DB_PASSWORD=change-me-database-password
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

JWT_SECRET_KEY=change-me-jwt-secret
ADMIN_PASSWORD=change-me-admin-password
ALLOW_DEV_ADMIN_PASSWORD=false

CORS_ALLOW_ORIGINS=https://tv.ostory.ai
AGENT_ONLY_MODE=true
LITE_WORKERS_COUNT=1
LOG_LEVEL=INFO
STORAGE_TYPE=local
STORAGE_BASE_PATH=/app/persistent_storage
LOCAL_STORAGE_PATH=/app/persistent_storage
AUDIO_UPLOAD_DIR=/app/persistent_storage/audio
MAX_UPLOAD_SIZE=1073741824

# Configure provider keys through the admin API configuration page after login.
HEALTH_CRITICAL_PROVIDERS=
