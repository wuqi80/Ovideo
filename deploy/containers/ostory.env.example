# Copy to /opt/ostory/.env and replace every change-me value before deployment.
POSTGRES_DB=ostory
POSTGRES_USER=ostory
POSTGRES_PASSWORD=change-me-database-password

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ostory
DB_USER=ostory
DB_PASSWORD=change-me-database-password
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

JWT_SECRET_KEY=change-me-jwt-secret
ADMIN_PASSWORD=change-me-admin-password
ALLOW_DEV_ADMIN_PASSWORD=false

# Public authentication. Production refuses fixed verification codes and fails
# closed when the digest secret or Aliyun SMS configuration is incomplete.
OSTORY_RUNTIME_ENV=production
OSTORY_SMS_PROVIDER=aliyun
OSTORY_VERIFICATION_CODE_SECRET=change-me-at-least-32-random-characters
OSTORY_SMS_SIGN_NAME=change-me-approved-sign-name
OSTORY_SMS_TEMPLATE_CODE=change-me-approved-template-code
ALIBABA_CLOUD_ACCESS_KEY_ID=change-me-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=change-me-access-key-secret
OSTORY_SMS_CODE_TTL_SECONDS=300
OSTORY_SMS_RESEND_SECONDS=60
OSTORY_SMS_DAILY_LIMIT=10
# Hard platform budget guard against rotating-phone abuse. Increase only after
# checking the SMS provider budget and real registration volume.
OSTORY_SMS_GLOBAL_DAILY_LIMIT=1000
OSTORY_SMS_MAX_ATTEMPTS=5

# Optional verified-email delivery. Registration succeeds when SMTP is disabled;
# the account remains unverified and no business email is sent.
OSTORY_SMTP_ENABLED=false
OSTORY_SMTP_HOST=
OSTORY_SMTP_PORT=587
OSTORY_SMTP_USERNAME=
OSTORY_SMTP_PASSWORD=
OSTORY_SMTP_STARTTLS=true
OSTORY_EMAIL_FROM_ADDRESS=
OSTORY_EMAIL_FROM_NAME=创剧
OSTORY_PUBLIC_BASE_URL=https://tv.ostory.ai

# Optional WeChat Pay APIv3 Native recharge. Keep all key materials in
# /opt/ostory/secrets on the host (or pass another directory as the deployment
# script's third argument). The directory is mounted read-only at /run/secrets;
# key material never belongs in this env file, repository, or container image.
# Recharge credits the permanent account-point bucket; subscriptions are not
# exposed by 创剧.
OSTORY_WECHAT_PAY_ENABLED=false
OSTORY_WECHAT_PAY_APP_ID=
OSTORY_WECHAT_PAY_MCH_ID=
OSTORY_WECHAT_PAY_MERCHANT_SERIAL_NO=
OSTORY_WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=/run/secrets/wechat_merchant_private_key.pem
OSTORY_WECHAT_PAY_API_V3_KEY_PATH=/run/secrets/wechat_api_v3_key
OSTORY_WECHAT_PAY_PUBLIC_KEY_ID=
OSTORY_WECHAT_PAY_PUBLIC_KEY_PATH=/run/secrets/wechatpay_public_key.pem
OSTORY_WECHAT_PAY_NOTIFY_URL=https://tv.ostory.ai/api/payments/wechat/notify
OSTORY_WECHAT_PAY_ORDER_EXPIRE_MINUTES=30
OSTORY_WECHAT_PAY_MAX_POINT_AMOUNT=1000000

CORS_ALLOW_ORIGINS=https://tv.ostory.ai
AGENT_ONLY_MODE=true
LITE_WORKERS_COUNT=1
EXTERNAL_API_WORKERS_COUNT=16
LOG_LEVEL=INFO
STORAGE_TYPE=local
STORAGE_BASE_PATH=/app/persistent_storage
LOCAL_STORAGE_PATH=/app/persistent_storage
AUDIO_UPLOAD_DIR=/app/persistent_storage/audio
MAX_UPLOAD_SIZE=1073741824

# Configure provider keys through the admin API configuration page after login.
HEALTH_CRITICAL_PROVIDERS=
# Daily expiring creation-point gift. After a continuous claim streak, the
# reduced range limits promotional cost while keeping the daily benefit.
OSTORY_DAILY_GIFT_MIN=10
OSTORY_DAILY_GIFT_MAX=50
OSTORY_DAILY_GIFT_REDUCED_AFTER_DAYS=7
OSTORY_DAILY_GIFT_REDUCED_MIN=10
OSTORY_DAILY_GIFT_REDUCED_MAX=20
