# PostgreSQL connection settings.
# Copy this file to database.env and replace DB_PASSWORD before running locally.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=my2_db
DB_USER=my2_user
DB_PASSWORD=change-me

# Optional pool settings.
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=50
DB_MAX_QUERIES=50000
DB_MAX_IDLE_TIME=300
