# 前端环境变量模板 —— 复制为 .env，填入团队负责人提供的真实密钥。
# .env 已在 .gitignore 中，不会被提交。
# 注意：后端实际从 local_start.ps1（或 start_cluster.sh）读取密钥；
# 本文件供前端构建期使用（VITE_ 前缀的变量）。

DEEPSEEK_API_KEY="<FILL_ME_DEEPSEEK_KEY>"
ARK_API_KEY="<FILL_ME_ARK_KEY>"
MINIMAX_API_KEY="<FILL_ME_MINIMAX_JWT>"
SORA2_API_KEY="<FILL_ME_SORA2_KEY>"
VITE_GEMINI_TEXT_API_KEY="<FILL_ME_GEMINI_TEXT_KEY>"
VITE_GEMINI_IMAGE_API_KEY="<FILL_ME_GEMINI_IMAGE_KEY>"
