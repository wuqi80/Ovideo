deploy/temp/
deploy/history/
*.log

# 冗余压缩快照
/deploy.zip

# 嵌套独立仓库（drama-docs 有自己的 remote）
/drama-docs/

# 操作系统 / 编辑器
.DS_Store
Thumbs.db
*.swp

# 端到端成片生成的素材产物（不入库）
deploy/output_film/

